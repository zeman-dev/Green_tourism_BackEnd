{
  "openapi": "3.0.0",
  "info": {
    "title": "Green Tourism Backend API",
    "version": "1.0.0",
    "description": "REST API for the Green Tourism application. Authentication is session-based and uses HttpOnly cookies (`sessionId`, `accessToken` and `refreshToken`). Register or login to receive the cookies, then send them with requests to protected endpoints."
  },
  "servers": [
    {
      "url": "http://localhost:3005",
      "description": "Local development server (PORT from .env)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local fallback server port"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Registration, login, logout and session refresh"
    },
    {
      "name": "Users",
      "description": "User profiles, avatars, saved stories and account management"
    },
    {
      "name": "Stories",
      "description": "Story listing, recommendations, details and creation"
    },
    {
      "name": "Categories",
      "description": "Story categories"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionId": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionId",
        "description": "Session identifier cookie set by register, login and refresh."
      },
      "accessToken": {
        "type": "apiKey",
        "in": "cookie",
        "name": "accessToken",
        "description": "Short-lived access token cookie set by register, login and refresh (15 minutes)."
      },
      "refreshToken": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refreshToken",
        "description": "Long-lived refresh token cookie set by register, login and refresh (24 hours)."
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Page number (1-based).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PerPageStories": {
        "name": "perPage",
        "in": "query",
        "required": false,
        "description": "Number of items per page.",
        "schema": {
          "type": "integer",
          "minimum": 5,
          "maximum": 30,
          "default": 10
        }
      },
      "PerPageRecommended": {
        "name": "perPage",
        "in": "query",
        "required": false,
        "description": "Number of recommended stories per page.",
        "schema": {
          "type": "integer",
          "minimum": 5,
          "maximum": 30,
          "default": 5
        }
      },
      "PerPageUsers": {
        "name": "perPage",
        "in": "query",
        "required": false,
        "description": "Number of users per page.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        }
      },
      "StoryCategory": {
        "name": "category",
        "in": "query",
        "required": false,
        "description": "Category name used to filter stories.",
        "schema": {
          "type": "string"
        }
      },
      "StoryType": {
        "name": "type",
        "in": "query",
        "required": false,
        "description": "Sorting mode. `popular` orders stories by rate descending.",
        "schema": {
          "type": "string",
          "enum": ["popular"]
        }
      },
      "StoryIdPath": {
        "name": "storyId",
        "in": "path",
        "required": true,
        "description": "MongoDB ObjectId of the story (24 hexadecimal characters).",
        "schema": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$",
          "example": "65f1a2b3c4d5e6f7a8b9c0d1"
        }
      },
      "UserIdPath": {
        "name": "userId",
        "in": "path",
        "required": true,
        "description": "MongoDB ObjectId of the user (24 hexadecimal characters).",
        "schema": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$",
          "example": "65f1a2b3c4d5e6f7a8b9c0d1"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Request validation failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid or expired session credentials.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Requested resource was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Resource conflicts with an existing record (for example, email already in use).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "ObjectId": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "description": "MongoDB ObjectId represented as a 24-character hexadecimal string.",
        "example": "65f1a2b3c4d5e6f7a8b9c0d1"
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": ["message"]
      },
      "ValidationError": {
        "type": "object",
        "description": "Response produced by celebrate's error middleware when Joi validation fails.",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 400
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "message": {
            "type": "string"
          },
          "validation": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ValidationIssue"
            }
          }
        }
      },
      "ValidationIssue": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "Request segment that failed validation."
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Paths of the invalid fields."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "description": "User document returned by the API. The password is always removed.",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 64
          },
          "avatarUrl": {
            "type": "string",
            "description": "URL of the user's avatar."
          },
          "articlesAmount": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "savedArticles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ObjectId"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "__v": {
            "type": "integer",
            "readOnly": true
          }
        },
        "required": ["_id", "name", "email"]
      },
      "PublicUser": {
        "type": "object",
        "description": "User document without the password and email fields.",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri"
          },
          "articlesAmount": {
            "type": "integer",
            "minimum": 0
          },
          "savedArticles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ObjectId"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "__v": {
            "type": "integer",
            "readOnly": true
          }
        },
        "required": ["_id", "name"]
      },
      "UserSummary": {
        "type": "object",
        "description": "Populated story owner.",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "name": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "category": {
            "type": "string",
            "description": "Category name."
          }
        },
        "required": ["_id", "category"]
      },
      "Story": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "img": {
            "type": "string",
            "description": "Cloudinary URL of the story cover image."
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "article": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          },
          "category": {
            "description": "Category ObjectId, or a populated category object depending on the endpoint.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/ObjectId"
              },
              {
                "$ref": "#/components/schemas/Category"
              }
            ]
          },
          "rate": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "ownerId": {
            "description": "Owner ObjectId, or a populated user summary depending on the endpoint.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/ObjectId"
              },
              {
                "$ref": "#/components/schemas/UserSummary"
              }
            ]
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "__v": {
            "type": "integer",
            "readOnly": true
          }
        },
        "required": ["_id", "img", "title", "article", "category", "ownerId"]
      },
      "StoriesPage": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "perPage": {
            "type": "integer",
            "minimum": 1
          },
          "totalStories": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          },
          "stories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Story"
            }
          }
        },
        "required": ["page", "perPage", "totalStories", "totalPages", "stories"]
      },
      "UsersPage": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "perPage": {
            "type": "integer",
            "minimum": 1
          },
          "totalUsers": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          },
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicUser"
            }
          }
        },
        "required": ["page", "perPage", "totalUsers", "totalPages", "users"]
      },
      "UserProfileSummary": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "username": {
            "type": "string",
            "description": "The user's name."
          },
          "avatarUrl": {
            "type": "string",
            "description": "URL of the user's avatar."
          },
          "articlesAmount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["_id", "username", "articlesAmount"]
      },
      "UserWithStoriesResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserProfileSummary"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "perPage": {
            "type": "integer",
            "minimum": 1
          },
          "totalStories": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          },
          "stories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Story"
            }
          }
        },
        "required": [
          "user",
          "page",
          "perPage",
          "totalStories",
          "totalPages",
          "stories"
        ]
      },
      "CurrentUserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "_id": {
                "$ref": "#/components/schemas/ObjectId"
              },
              "name": {
                "type": "string"
              },
              "avatarUrl": {
                "type": "string"
              },
              "articlesAmount": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["_id", "name", "articlesAmount"]
          }
        },
        "required": ["user"]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32,
            "description": "Trimmed user name."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 64,
            "description": "Trimmed and lowercased email address."
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72
          },
          "avatarUrl": {
            "description": "Optional avatar URL (http or https). An empty string is allowed and results in the default avatar.",
            "oneOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              {
                "type": "string",
                "enum": [""]
              }
            ]
          }
        },
        "required": ["name", "email", "password"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "maxLength": 72
          }
        },
        "required": ["email", "password"]
      },
      "UpdateUserRequest": {
        "type": "object",
        "minProperties": 1,
        "description": "At least one of the fields must be provided.",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 64,
            "description": "Changing the email triggers a confirmation email to the current address."
          }
        }
      },
      "ConfirmEmailRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT token from the email change confirmation link."
          }
        },
        "required": ["token"]
      },
      "AvatarUploadRequest": {
        "type": "object",
        "properties": {
          "avatar": {
            "type": "string",
            "format": "binary",
            "description": "Image file (image/* mime type, maximum 2 MB)."
          }
        },
        "required": ["avatar"]
      },
      "CreateStoryRequest": {
        "type": "object",
        "properties": {
          "img": {
            "type": "string",
            "format": "binary",
            "description": "Cover image file (image/* mime type, maximum 2 MB). Required."
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "article": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          },
          "category": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$",
            "description": "MongoDB ObjectId of an existing category."
          }
        },
        "required": ["img", "title", "article", "category"]
      },
      "SavedArticlesResponse": {
        "type": "object",
        "properties": {
          "savedArticles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ObjectId"
            }
          }
        },
        "required": ["savedArticles"]
      },
      "AvatarResponse": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Cloudinary URL of the updated avatar."
          }
        },
        "required": ["url"]
      },
      "UpdateUserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "emailVerificationSent": {
            "type": "boolean",
            "description": "True when an email change was requested and a confirmation email was sent."
          }
        },
        "required": ["user", "emailVerificationSent"]
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": ["message"]
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "description": "Creates a user, hashes the password, starts a session and sets the `sessionId`, `accessToken` and `refreshToken` cookies.",
        "operationId": "registerUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered and session cookies set.",
            "headers": {
              "Set-Cookie": {
                "description": "Contains the sessionId, accessToken and refreshToken cookies.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in",
        "description": "Validates credentials, replaces any existing sessions for the user and sets new session cookies.",
        "operationId": "loginUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in and session cookies set.",
            "headers": {
              "Set-Cookie": {
                "description": "Contains the sessionId, accessToken and refreshToken cookies.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log out",
        "description": "Deletes the current session and clears the session cookies.",
        "operationId": "logoutUser",
        "security": [
          {
            "sessionId": [],
            "accessToken": []
          }
        ],
        "responses": {
          "204": {
            "description": "Session deleted and cookies cleared. No response body."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh the session",
        "description": "Validates the refresh token, rotates the session and sets new session cookies.",
        "operationId": "refreshUserSession",
        "security": [
          {
            "sessionId": [],
            "refreshToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session refreshed and new cookies set.",
            "headers": {
              "Set-Cookie": {
                "description": "Contains the rotated sessionId, accessToken and refreshToken cookies.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List users",
        "description": "Returns a paginated list of users without their email and password fields, newest first.",
        "operationId": "getUsers",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPageUsers"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated users.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Get the current user",
        "description": "Returns the authenticated user's basic profile.",
        "operationId": "getCurrentUser",
        "security": [
          {
            "sessionId": [],
            "accessToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Update the current user",
        "description": "Updates the user's name and/or requests an email change. When the email changes, a confirmation link is emailed to the current address and the response has `emailVerificationSent: true`.",
        "operationId": "updateUser",
        "security": [
          {
            "sessionId": [],
            "accessToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated. If the email changed, a confirmation email was sent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateUserResponse"
                }
              }
            }
          },
          "400": {
